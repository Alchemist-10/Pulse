---
// Click-through presentation of Pulse: story first, then the architecture.
// Every number comes from facts.ts. The QR is illustrative, not scannable.
import "@fontsource/noto-sans/400.css";
import "@fontsource/noto-sans/500.css";
import "@fontsource/noto-sans/700.css";
import "@fontsource/noto-sans-mono/400.css";
import "../styles/global.css";
import { stats, seed, REPO, team, course } from "../data/facts";
const names = team.map((m) => m.name).join(", ");

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Deterministic pseudo-QR: three finder squares plus seeded noise.
const N = 21;
let seedN = 7;
const rnd = () => ((seedN = (seedN * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff);
const finder = (x: number, y: number) =>
  [[0, 0], [N - 7, 0], [0, N - 7]].some(([fx, fy]) => x >= fx && x < fx + 7 && y >= fy && y < fy + 7);
const finderOn = (x: number, y: number) => {
  const [fx, fy] = [[0, 0], [N - 7, 0], [0, N - 7]].find(([a, b]) => x >= a && x < a + 7 && y >= b && y < b + 7)!;
  const dx = x - fx, dy = y - fy;
  return dx === 0 || dx === 6 || dy === 0 || dy === 6 || (dx >= 2 && dx <= 4 && dy >= 2 && dy <= 4);
};
const qr: { x: number; y: number }[] = [];
for (let y = 0; y < N; y++)
  for (let x = 0; x < N; x++) {
    const near = (x < 8 && y < 8) || (x > N - 9 && y < 8) || (x < 8 && y > N - 9);
    if (finder(x, y) ? finderOn(x, y) : !near && rnd() > 0.52) qr.push({ x, y });
  }

const functional = [
  ["Accounts", "Register, verify email, step-up password check for sensitive actions."],
  ["Timeline", "Five entry kinds. Corrections add a new entry, never overwrite."],
  ["Filing", "Provider staff file entries and documents, even for unregistered patients."],
  ["Consent", "Scoped by entry type and date window, optional expiry, revoked at once."],
  ["Access log", "Every read listed for the patient, with notifications."],
  ["Emergency card", "Patient-written card, QR, 60-minute break-glass with a reason."],
  ["Analytics", "Lab trends, medications, visits, computed at request time."],
  ["Ask your record", "Plain questions answered by fixed rules, in four languages."],
];
const nonFunctional = [
  ["Privacy", "Consent filter on every clinical read. Denied reads are 404, not 403."],
  ["Auditability", "Audit table is append-only by database GRANT."],
  ["Security", "Argon2id, opaque Redis sessions, CSRF origin guard, default-deny routes."],
  ["Integrity", "No in-place edits. No clinical values in JSONB."],
  ["Usability", "Four locales, mobile-first, colour never carries meaning alone."],
  ["Maintainability", "Modular monolith with import and SQL boundaries enforced in CI."],
  ["Testability", "Integration tests on real PostgreSQL, negative tests first."],
  ["Deployability", `docker compose up, ${stats.composeServices} services, seeded.`],
];
const layers = [
  ["routes.py", "HTTP only", "Parse, validate, delegate. No business logic."],
  ["service.py", "Business rules", "Consent, permissions, transactions. No SQL, no framework."],
  ["repository.py", "All SQL", "One query builder for clinical reads."],
  ["models + schemas", "Shape", "SQLAlchemy tables and the Pydantic API contract."],
];
const decisions = [
  ["0003", "Opaque Redis sessions", "JWT", "Logout and role changes apply server-side, at once."],
  ["0006", "One query builder for consent", "Per-endpoint checks", "A filter cannot be forgotten in sixty places."],
  ["0007", "Administrators read no clinical data", "A superuser role", "The audit log is safe for admins to see."],
  ["0008", "Append-only audit by GRANT", "Convention", "The app role cannot update or delete history."],
  ["0001", "Joined-table entry inheritance", "One wide table or JSONB", "Typed columns, no clinical JSON."],
  ["0018", "Rule-based ask-your-record", "A language model", "Every answer passes the consent filter."],
];
const faqs = [
  ["Why not JWT?", "Opaque Redis sessions are checked on the server, so logout and role changes take effect at once."],
  ["Why a monolith, not microservices?", "One laptop-scale deployment with no scaling need. Module boundaries are linted as if extraction were coming."],
  ["Why 404 instead of 403?", "A 403 confirms the record exists, which reveals that a person is a patient here at all."],
  ["Is there an AI chatbot?", "No model. Fixed rules map a question to a query that goes through the same consent filter."],
  ["Why not translate diagnoses?", "The interface is localised, clinical text is not. Translating it would invent a medical claim."],
  [`Is any data real?`, `None. Synthea plus an Indian overlay gives ${seed.patients} synthetic patients, committed to the repo.`],
];
const patterns = [
  ["Modular monolith", "11 modules, one deployable, one database."],
  ["Layered, repository", "routes, service, repository. SQL lives in one place."],
  ["Ports and adapters", "Storage, notification, identity behind interfaces."],
  ["Contract first", "OpenAPI generates the TypeScript types. Stubs before code."],
  ["Fitness functions", "Route coverage plus 4 lints fail the build on a violated rule."],
  ["Negative tests first", "Revoked, expired, wrong scope, admin: each must return nothing."],
];
const quality = [
  [stats.backendTests, "backend tests on real PostgreSQL"],
  [stats.e2eTests, "browser tests, plus 1 live run on the real stack"],
  [stats.endpoints, "endpoints, every one declares a permission"],
  [stats.modules, "modules with enforced boundaries"],
  [stats.adrs, "decision records with alternatives"],
  [stats.catalogKeys, "interface strings in each of 4 languages"],
];
const total = 18;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pulse, the presentation</title>
    <meta name="description" content="A click-through presentation of Pulse: a patient-owned lifelong health record, told as a story and then as an architecture." />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem("pulse-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="present">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></symbol>
      <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" /></symbol>
      <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3l10 18H2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M12 10v5M12 18v.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></symbol>
      <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></symbol>
    </svg>

    <div class="viewport" id="viewport">
      <div class="stage" id="stage">

        <!-- 1 · Title -->
        <section class="slide s-title" data-builds="0" data-t="fade" aria-label="Title">
          <svg class="ecg" viewBox="0 0 1280 200" preserveAspectRatio="none" aria-hidden="true">
            <path class="ecg__line" data-at="0" d="M0 100 H430 l20 -10 l20 10 H520 l14 18 l26 -120 l26 150 l16 -48 H700 q40 -50 80 0 H1280" />
          </svg>
          <div class="title-block">
            <p class="kicker">{course.name}</p>
            <h1>Pulse</h1>
            <p class="lede">A lifelong health record that the patient owns.</p>
            <p class="team">{names}</p>
            <p class="inst">{course.institute}, {course.team}</p>
            <p class="inst">Guide: {course.guide}</p>
          </div>
        </section>

        <!-- 2 · Accident -->
        <section class="slide s-scene" data-builds="2" data-t="slide" aria-label="Story: the accident">
          <svg class="scene" viewBox="0 0 1280 720" aria-hidden="true">
            <g transform="translate(0 90)"><g data-at="1" class="world">
              <rect x="0" y="500" width="1280" height="150" class="road" />
              <path d="M0 575 H1280" class="lane" />
              <g class="lamp"><path d="M1200 500 V330" class="pole" /><circle cx="1200" cy="322" r="14" class="bulb" /><path d="M1200 336 L1140 500 H1260 Z" class="beam" /></g>
              <g class="ravi" data-at="1" id="ravi">
                <g class="walk">
                  <circle cx="0" cy="-92" r="15" />
                  <path d="M0 -76 V-30 M0 -64 L-18 -40 M0 -64 L18 -40 M0 -30 L-14 0 M0 -30 L14 0" />
                </g>
              </g>
              <g class="car" data-at="1" id="car">
                <path d="M0 62 V30 Q0 14 18 12 L70 8 L110 -22 H210 L252 8 L300 14 Q320 18 320 36 V62 Z" class="car__body" />
                <path d="M122 -14 H198 L228 8 H100 Z" class="car__glass" />
                <circle cx="80" cy="64" r="22" class="wheel" /><circle cx="250" cy="64" r="22" class="wheel" />
                <path d="M320 40 L560 4 V76 L320 56 Z" class="car__beam" />
              </g>
              <g class="burst" data-at="1" transform="translate(990 520)">
                <path d="M0 -70 L16 -26 L60 -48 L34 -8 L80 6 L30 22 L50 64 L8 40 L-6 84 L-24 36 L-70 58 L-40 14 L-86 -6 L-34 -22 L-52 -66 L-12 -38 Z" />
              </g>
            </g></g>
          </svg>
          <div class="copy">
            <p class="kicker rv on" data-at="0">A story</p>
            <h2 class="rv" data-at="0" data-out="2">9:42 pm. Ravi, 34, is walking home.</h2>
            <h2 class="rv warn" data-at="2">Hit by a car. Unconscious. No ID.</h2>
            <ul class="asks rv" data-at="2">
              <li>Blood group?</li><li>Allergies?</li><li>Medicines?</li><li>Who to call?</li>
            </ul>
            <p class="lede rv" data-at="2">Nobody can answer. The record is in three hospitals, and none of them are here.</p>
          </div>
        </section>

        <!-- 3 · Scan -->
        <section class="slide s-scene" data-builds="3" data-t="slide" aria-label="Story: the QR on the phone">
          <svg class="scene" viewBox="0 0 1280 720" aria-hidden="true">
            <rect x="0" y="560" width="1280" height="160" class="road" />
            <g class="hospital"><rect x="40" y="470" width="260" height="90" rx="8" class="bld" /><rect x="150" y="486" width="40" height="12" class="crossH" /><rect x="164" y="472" width="12" height="40" class="crossH" /><rect x="70" y="510" width="30" height="50" class="door" /><rect x="240" y="510" width="30" height="50" class="door" /></g>
            <g class="ambulance" data-at="0">
              <rect x="0" y="470" width="260" height="96" rx="12" class="amb" />
              <rect x="190" y="486" width="52" height="40" class="car__glass" />
              <rect x="40" y="498" width="70" height="14" class="crossH" /><rect x="68" y="470" width="14" height="70" class="crossH" />
              <circle cx="60" cy="570" r="20" class="wheel" /><circle cx="200" cy="570" r="20" class="wheel" />
              <rect x="120" y="456" width="44" height="14" rx="4" class="siren" />
            </g>
            <g transform="translate(150 0)"><g class="phone-back rv" data-at="1">
              <rect x="820" y="90" width="280" height="520" rx="36" class="phone" />
              <circle cx="880" cy="150" r="22" class="cam" /><circle cx="934" cy="150" r="12" class="cam" />
              <rect x="860" y="250" width="200" height="270" rx="14" class="sticker" />
              <text x="960" y="284" text-anchor="middle" class="stk">In case of emergency</text>
              <g transform="translate(886 300) scale(7)" class="qr">
                {qr.map((c) => <rect x={c.x} y={c.y} width="1" height="1" />)}
              </g>
            </g></g>
            <g transform="translate(150 0)"><g class="scanner rv" data-at="2">
              <rect x="540" y="230" width="190" height="360" rx="28" class="phone2" />
              <rect x="556" y="252" width="158" height="316" rx="14" class="screen" />
              <rect x="556" y="252" width="158" height="4" class="sweep" />
              <text x="635" y="545" text-anchor="middle" class="stk">Scanning</text>
            </g></g>
            <g transform="translate(1110 560)"><g class="ok rv" data-at="3">
              <circle r="38" class="okc" /><use href="#i-check" x="-22" y="-22" width="44" height="44" />
            </g></g>
          </svg>
          <div class="copy">
            <p class="kicker rv on" data-at="0">At the hospital</p>
            <h2 class="rv" data-at="0">The ambulance has no record. The phone does.</h2>
            <p class="lede rv" data-at="1">Ravi made an emergency card and put its QR on the back of his phone.</p>
            <p class="lede rv" data-at="2">The paramedic scans it, signed in to the hospital system.</p>
            <p class="lede rv" data-at="3">Only the card opens. His record stays closed.</p>
          </div>
        </section>

        <!-- 4 · Card -->
        <section class="slide s-split" data-builds="4" data-t="slide" aria-label="Story: the emergency card">
          <div class="copy">
            <p class="kicker">Four seconds later</p>
            <h2>The doctor knows what to avoid.</h2>
            <ul class="ticks">
              <li class="rv" data-at="2"><svg class="ic"><use href="#i-check" /></svg>No penicillin. Asthma inhaler on hand.</li>
              <li class="rv" data-at="3"><svg class="ic"><use href="#i-check" /></svg>Wife called from the card.</li>
              <li class="rv" data-at="4"><svg class="ic"><use href="#i-lock" /></svg>Nothing else opened. The scan is logged and Ravi is notified.</li>
            </ul>
          </div>
          <div class="phone-ui">
            <div class="phone-ui__bar">Emergency card, Ravi Menon</div>
            <div class="row rv" data-at="0"><span>Blood type</span><b>O+</b></div>
            <div class="row crit rv" data-at="1"><span><svg class="ic"><use href="#i-alert" /></svg>Allergy</span><b>Penicillin</b></div>
            <div class="row rv" data-at="1"><span>Condition</span><b>Asthma</b></div>
            <div class="row rv" data-at="2"><span>Medication</span><b>Salbutamol inhaler</b></div>
            <div class="row rv" data-at="3"><span>Next of kin</span><b>Asha Menon, wife<br /><small>+91 90000 00000</small></b></div>
          </div>
        </section>

        <!-- 5 · Priya -->
        <section class="slide s-split" data-builds="3" data-t="zoom" aria-label="Story: ask your record">
          <div class="copy">
            <p class="kicker">A smaller moment</p>
            <h2>New city, new doctor. Priya forgets her tablets.</h2>
            <div class="bubble doc rv" data-at="0">"Which medicines are you on?"</div>
            <div class="bubble pat rv" data-at="1">"A small white one, for sugar?"</div>
            <p class="lede rv" data-at="3">No AI model. Fixed rules over her own record. Nothing she asks is stored.</p>
          </div>
          <div class="phone-ui">
            <div class="phone-ui__bar">Ask your record</div>
            <div class="typed rv" data-at="2"><span class="typing">What medicines am I taking?</span></div>
            <div class="answer rv" data-at="2">
              <b>Active medications</b>
              <ul><li>Metformin 500 mg, twice daily</li><li>Amlodipine 5 mg, once daily</li></ul>
            </div>
            <div class="receipt rv" data-at="3"><svg class="ic"><use href="#i-check" /></svg>Read from your entries through the consent filter. 2 entries. Logged.</div>
          </div>
        </section>

        <!-- 6 · Introduction -->
        <section class="slide s-plain" data-builds="4" data-t="slide" aria-label="Introduction">
          <p class="kicker">Introduction</p>
          <h2>Pulse is a lifelong health record with a simple rule: the patient decides.</h2>
          <div class="roles">
            <div class="role rv" data-at="1"><h3>Patients</h3><p>Own the record, grant and revoke consent, see every access.</p></div>
            <div class="role rv" data-at="2"><h3>Providers</h3><p>File entries and documents, including for people who never registered.</p></div>
            <div class="role rv" data-at="3"><h3>Clinicians</h3><p>Read only inside an active consent. The role alone grants nothing.</p></div>
            <div class="role rv" data-at="4"><h3>Administrators</h3><p>Keep identities clean. Can never read clinical data.</p></div>
          </div>
          <p class="foot rv on" data-at="0">Built for India: four languages, synthetic data only, never a real patient.</p>
        </section>

        <!-- 7 · Problem and objectives -->
        <section class="slide s-two" data-builds="2" data-t="slide" aria-label="Problem statement and objectives">
          <div>
            <p class="kicker">Problem statement</p>
            <h2>Health history is scattered, and the patient is the last to know who saw it.</h2>
            <ul class="plain">
              <li class="rv" data-at="0">Records sit in separate hospitals and on paper.</li>
              <li class="rv" data-at="0">Emergency staff have nothing to go on.</li>
              <li class="rv" data-at="1">Access is implied. Withdrawing it is not a thing.</li>
              <li class="rv" data-at="1">Nobody can say who read what.</li>
            </ul>
          </div>
          <div>
            <p class="kicker">Objectives</p>
            <ol class="obj">
              <li class="rv" data-at="2"><b>Own.</b> One record that follows the patient for life.</li>
              <li class="rv" data-at="2"><b>Consent.</b> Enforced on every read, revoked immediately.</li>
              <li class="rv" data-at="2"><b>Account.</b> Every access recorded and visible to the patient.</li>
              <li class="rv" data-at="2"><b>Reach.</b> Four languages, an emergency path, mobile first.</li>
            </ol>
          </div>
        </section>

        <!-- 8 · Functional -->
        <section class="slide s-plain" data-builds="3" data-t="slide" aria-label="Functional requirements">
          <p class="kicker">Requirements</p>
          <h2>What it does</h2>
          <div class="grid4">
            {functional.map(([t, d], i) => (
              <div class="cell rv" data-at={Math.floor(i / 3)}><h3>{t}</h3><p>{d}</p></div>
            ))}
          </div>
        </section>

        <!-- 9 · Non-functional -->
        <section class="slide s-plain" data-builds="3" data-t="slide" aria-label="Non-functional requirements">
          <p class="kicker">Requirements</p>
          <h2>What it must stay true to</h2>
          <div class="grid4">
            {nonFunctional.map(([t, d], i) => (
              <div class="cell rv" data-at={Math.floor(i / 3)}><h3>{t}</h3><p>{d}</p></div>
            ))}
          </div>
        </section>

        <!-- 10 · Architecture overview -->
        <section class="slide s-plain" data-builds="4" data-t="zoom" aria-label="System architecture">
          <p class="kicker">System architecture</p>
          <h2>One origin, one backend, one database</h2>
          <svg class="arch" viewBox="0 0 1120 440" role="img" aria-label="Browser to Caddy to Next.js and FastAPI, which uses PostgreSQL, Redis and three adapters">
            <g class="node rv" data-at="0"><rect x="10" y="165" width="150" height="80" rx="12" /><text x="85" y="200" text-anchor="middle">Browser</text><text x="85" y="224" text-anchor="middle" class="sub">PWA, 4 locales</text></g>
            <path class="wire dr" data-at="0" d="M160 205 H235" />
            <g class="node rv" data-at="0"><rect x="235" y="165" width="150" height="80" rx="12" /><text x="310" y="200" text-anchor="middle">Caddy</text><text x="310" y="224" text-anchor="middle" class="sub">same origin</text></g>
            <path class="wire dr" data-at="1" d="M385 190 C430 190 430 100 470 100" />
            <text class="lbl rv" data-at="1" x="402" y="118">/*</text>
            <path class="wire dr" data-at="1" d="M385 220 C430 220 430 300 470 300" />
            <text class="lbl rv" data-at="1" x="396" y="290">/api/*</text>
            <g class="node rv" data-at="1"><rect x="470" y="55" width="220" height="90" rx="12" /><text x="580" y="92" text-anchor="middle">Next.js 16</text><text x="580" y="118" text-anchor="middle" class="sub">screens, next-intl</text></g>
            <g class="node big rv" data-at="1"><rect x="470" y="215" width="330" height="205" rx="14" /><text x="635" y="245" text-anchor="middle">FastAPI, modular monolith</text>
              {["auth","users","patients","providers","records","consent","audit","notifications","analytics","admin","ask"].map((m, i) => (
                <g><rect x={486 + (i % 3) * 108} y={256 + Math.floor(i / 3) * 40} width="100" height="32" rx="8" class="chip" /><text x={536 + (i % 3) * 108} y={277 + Math.floor(i / 3) * 40} text-anchor="middle" class="chip-t">{m}</text></g>
              ))}
            </g>
            <path class="wire dr" data-at="2" d="M800 280 H880" />
            <path class="wire dr" data-at="2" d="M800 345 H880" />
            <g class="node rv" data-at="2"><rect x="880" y="240" width="230" height="80" rx="12" /><text x="995" y="274" text-anchor="middle">PostgreSQL 18</text><text x="995" y="298" text-anchor="middle" class="sub">all durable data</text></g>
            <g class="node rv" data-at="2"><rect x="880" y="325" width="230" height="80" rx="12" /><text x="995" y="359" text-anchor="middle">Redis 8</text><text x="995" y="383" text-anchor="middle" class="sub">sessions only, never truth</text></g>
            <path class="wire dr" data-at="3" d="M800 235 C850 235 850 120 880 120" />
            <g class="node rv" data-at="3"><rect x="880" y="60" width="230" height="120" rx="12" /><text x="995" y="92" text-anchor="middle">Adapters</text><text x="995" y="120" text-anchor="middle" class="sub">StorageProvider</text><text x="995" y="142" text-anchor="middle" class="sub">NotificationProvider</text><text x="995" y="164" text-anchor="middle" class="sub">IdentityProvider</text></g>
            <circle class="packet" data-at="4" r="7" />
          </svg>
        </section>

        <!-- 11 · Layers -->
        <section class="slide s-two" data-builds="4" data-t="slide" aria-label="Layers inside a module">
          <div>
            <p class="kicker">Inside a module</p>
            <h2>Each layer has one job, and one thing it may not do</h2>
            <p class="lede rv" data-at="4">Modules talk through service interfaces, never each other's tables. A CI lint fails the build if they do.</p>
          </div>
          <div class="stack">
            {layers.map(([f, h, d], i) => (
              <div class="layer rv" data-at={i + 1}><code>{f}</code><b>{h}</b><span>{d}</span></div>
            ))}
          </div>
        </section>

        <!-- 12 · One query -->
        <section class="slide s-two wide" data-builds="4" data-t="slide" aria-label="The consent query">
          <div>
            <p class="kicker">The rule everything rests on</p>
            <h2>Every clinical read starts from one function</h2>
            <ul class="plain">
              <li class="rv" data-at="1"><b>The patient</b> sees their own entries.</li>
              <li class="rv" data-at="2"><b>Provider staff</b> see only what their provider authored.</li>
              <li class="rv" data-at="3"><b>A clinician</b> sees what an active consent allows.</li>
              <li class="rv" data-at="4"><b>Anyone else</b> gets false(). Default deny.</li>
            </ul>
          </div>
          <pre class="code"><code><span class="l">async def accessible_entries(session, actor, patient_id):</span>
<span class="l rv" data-at="1">    if await actor_owns_patient(session, actor, patient_id):
        conditions.append(MedicalEntry.patient_id == patient_id)</span>
<span class="l rv" data-at="2">    if provider_id is not None:
        conditions.append(and_(MedicalEntry.patient_id == patient_id,
            MedicalEntry.source_provider_id == provider_id))</span>
<span class="l rv" data-at="3">    if actor.role is Role.CLINICIAN:
        conditions.append(and_(..., clinical_access_predicate(
            patient_id, actor.user_id, entry_type, occurred_at)))</span>
<span class="l rv" data-at="4">    if not conditions:
        conditions.append(false())</span>
<span class="l">    return select(MedicalEntry).where(or_(*conditions))</span></code></pre>
        </section>

        <!-- 13 · Consent -->
        <section class="slide s-plain" data-builds="3" data-t="slide" aria-label="Consent and revocation">
          <p class="kicker">Consent engine</p>
          <h2>Revoking is one tap, and the next read is refused</h2>
          <div class="flow">
            <div class="step rv" data-at="0"><span class="n">1</span><h3>Patient grants</h3><p>Password re-check. Scoped to entry types and a date window.</p><span class="pill ok"><svg class="ic"><use href="#i-check" /></svg>Consent active</span></div>
            <div class="step rv" data-at="1"><span class="n">2</span><h3>Clinician reads</h3><p>The filter passes. The access is logged once.</p><span class="pill ok"><svg class="ic"><use href="#i-check" /></svg>200, entries</span></div>
            <div class="step rv" data-at="2"><span class="n">3</span><h3>Patient revokes</h3><p>No password prompt. The permission row is deleted in the same transaction.</p><span class="pill bad"><svg class="ic"><use href="#i-x" /></svg>Consent revoked</span></div>
            <div class="step rv" data-at="3"><span class="n">4</span><h3>Same clinician reads</h3><p>Nothing cached, so the very next query denies it.</p><span class="pill bad"><svg class="ic"><use href="#i-lock" /></svg>404, not 403</span></div>
          </div>
          <p class="foot rv" data-at="3">A 403 would confirm the person is a patient here. A 404 says nothing.</p>
        </section>

        <!-- 14 · Decisions -->
        <section class="slide s-plain" data-builds="3" data-t="slide" aria-label="Key decisions">
          <p class="kicker">Decisions, {stats.adrs} recorded</p>
          <h2>We chose, and wrote down what we gave up</h2>
          <div class="adrs">
            <div class="adr head"><span>ADR</span><span>Chosen</span><span>Over</span><span>Because</span></div>
            {decisions.map(([n, c, o, w], i) => (
              <div class="adr rv" data-at={Math.floor(i / 2) + 1}>
                <span class="num">{n}</span><b>{c}</b><span class="over">{o}</span><span class="why">{w}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- 15 · Patterns -->
        <section class="slide s-plain" data-builds="2" data-t="slide" aria-label="Patterns and practices">
          <p class="kicker">Patterns and practices</p>
          <h2>Architecture the build enforces</h2>
          <div class="grid3">
            {patterns.map(([t, d], i) => (
              <div class="cell rv" data-at={i < 3 ? 1 : 2}><h3>{t}</h3><p>{d}</p></div>
            ))}
          </div>
          <p class="foot rv on" data-at="0">A rule that only lives in a document gets broken by accident. These live in CI.</p>
        </section>

        <!-- 16 · Quality -->
        <section class="slide s-plain" data-builds="1" data-t="zoom" aria-label="Verification">
          <p class="kicker">Verification</p>
          <h2>The risk is one missed filter, so that is what we test</h2>
          <div class="grid3 nums">
            {quality.map(([n, l]) => (
              <div class="cell num rv" data-at="1"><b class="big" data-count={n}>0</b><p>{l}</p></div>
            ))}
          </div>
        </section>

        <!-- 17 · FAQ -->
        <section class="slide s-plain" data-builds="3" data-t="slide" aria-label="Questions and answers">
          <p class="kicker">FAQ</p>
          <h2>Questions we expect</h2>
          <div class="faq">
            {faqs.map(([q, a], i) => (
              <div class="qa rv" data-at={Math.floor(i / 2) + 1}><h3>{q}</h3><p>{a}</p></div>
            ))}
          </div>
        </section>

        <!-- 18 · Close -->
        <section class="slide s-title" data-builds="0" data-t="fade" aria-label="Close">
          <div class="title-block">
            <p class="kicker">Pulse</p>
            <h1 class="close">Patients own their history. Clinicians read it with consent. Every access is recorded.</h1>
            <p class="team">{names}</p>
            <p class="inst">{course.institute}, {course.team}. Guide: {course.guide}</p>
            <p class="inst"><a href={REPO}>{REPO.replace("https://", "")}</a></p>
          </div>
        </section>

      </div>
    </div>

    <nav class="hud" aria-label="Slides">
      <a class="hud__btn" href={`${base}/`} aria-label="Leave the presentation">Exit</a>
      <button class="hud__btn" id="prev" type="button" aria-label="Previous">&lsaquo;</button>
      <ol class="dots" id="dots">
        {Array.from({ length: total }, (_, i) => <li><button type="button" data-go={i} aria-label={`Slide ${i + 1}`}></button></li>)}
      </ol>
      <button class="hud__btn" id="next" type="button" aria-label="Next">&rsaquo;</button>
      <span class="count" id="count" aria-live="polite">1 / {total}</span>
      <button class="hud__btn" id="fs" type="button" aria-label="Toggle fullscreen">Full screen</button>
    </nav>
  </body>
</html>

